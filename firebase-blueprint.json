{
  "entities": {
    "Trip": {
      "title": "Trip",
      "description": "Represents a group travel trip with locked INR currency and members",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 120 },
        "destination": { "type": "string", "maxLength": 120 },
        "startDate": { "type": "string", "maxLength": 30 },
        "endDate": { "type": "string", "maxLength": 30 },
        "currency": { "type": "string", "maxLength": 10 },
        "inviteCode": { "type": "string", "maxLength": 20 },
        "members": { "type": "array", "description": "List of friends in trip with names and UPI IDs" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "name", "destination", "startDate", "endDate", "currency", "inviteCode", "members", "createdAt"]
    },
    "Expense": {
      "title": "Expense",
      "description": "An expense item logged for a trip in Indian Rupees (INR)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "tripId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 150 },
        "amount": { "type": "number" },
        "category": { "type": "string", "maxLength": 50 },
        "date": { "type": "string", "maxLength": 30 },
        "paidBy": { "type": "object" },
        "splitType": { "type": "string", "maxLength": 30 },
        "splits": { "type": "array" },
        "notes": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "tripId", "title", "amount", "category", "date", "paidBy", "splitType", "splits", "createdAt"]
    },
    "KittyContribution": {
      "title": "KittyContribution",
      "description": "Upfront cash pooled by a friend for the shared kitty pot in INR",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "tripId": { "type": "string", "maxLength": 128 },
        "memberId": { "type": "string", "maxLength": 128 },
        "amount": { "type": "number" },
        "date": { "type": "string", "maxLength": 30 },
        "note": { "type": "string", "maxLength": 200 },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "tripId", "memberId", "amount", "date", "createdAt"]
    },
    "SettlementRecord": {
      "title": "SettlementRecord",
      "description": "Recorded bilateral debt settlement via UPI or cash in INR",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "tripId": { "type": "string", "maxLength": 128 },
        "fromMemberId": { "type": "string", "maxLength": 128 },
        "toMemberId": { "type": "string", "maxLength": 128 },
        "amount": { "type": "number" },
        "date": { "type": "string", "maxLength": 30 },
        "note": { "type": "string", "maxLength": 200 },
        "upiRef": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "tripId", "fromMemberId", "toMemberId", "amount", "date", "createdAt"]
    }
  },
  "firestore": {
    "/trips/{tripId}": {
      "schema": "Trip",
      "description": "Root collection for all group travel trips"
    },
    "/trips/{tripId}/expenses/{expenseId}": {
      "schema": "Expense",
      "description": "Expenses subcollection under a specific trip"
    },
    "/trips/{tripId}/kitty/{kittyId}": {
      "schema": "KittyContribution",
      "description": "Shared cash pot pool contributions under a trip"
    },
    "/trips/{tripId}/settlements/{settlementId}": {
      "schema": "SettlementRecord",
      "description": "Settled UPI debt transactions under a trip"
    }
  }
}
