{
  "name": "rupeesplit",
  "private": true,
  "version": "1.0.2",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build && node scripts/copy-sw.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:pwa": "node scripts/verify-pwa.mjs",
    "test:settlement": "node --import tsx --test src/utils/settlement.test.ts",
    "test:security": "node --test scripts/firestore-rules-guard.test.mjs",
    "test": "npm run test:settlement && npm run test:security && npm run test:firestore",
    "icons:generate": "node scripts/generate_icons.cjs",
    "test:firestore": "node --test scripts/firestore-rules.test.mjs",
    "deploy:hosting": "npm run build && firebase deploy --only hosting"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-react": "^6.1.1",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^13.1.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capgo/capacitor-contacts": "^8.1.0",
    "sharp": "^0.34.5",
    "@capacitor/app": "^8.0.0",
    "@capgo/capacitor-social-login": "^8.7.0"
  },
  "devDependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "vite-plugin-pwa": "^2.0.0",
    "@capacitor/cli": "^8.0.0",
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase-tools": "^14.22.0",
    "typescript": "^7.0.2"
  },
  "androidVersionCode": 3
}
