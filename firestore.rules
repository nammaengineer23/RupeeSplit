rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isTripMember(data) {
      return request.auth != null && data.memberUids is list
        && request.auth.uid in data.memberUids;
    }

    function canAccessTrip(tripId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/trips/$(tripId))
        && isTripMember(get(/databases/$(database)/documents/trips/$(tripId)).data);
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidTrip(data) {
      return data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() > 0 && data.name.size() <= 120
        && data.destination is string && data.destination.size() <= 120
        && data.currency is string && data.currency.size() >= 3 && data.currency.size() <= 10
        && data.inviteCode is string && data.inviteCode.size() == 20
        && data.members is list && data.members.size() > 0 && data.members.size() <= 50
        && data.ownerUid is string && data.ownerUid.size() > 0
        && data.memberUids is list && data.memberUids.size() > 0 && data.memberUids.size() <= 100
        && data.ownerUid in data.memberUids
        && data.createdAt is number;
    }

    function isValidExpense(data, tripId) {
      return data.id is string && data.id.size() <= 128
        && data.tripId == tripId
        && data.title is string && data.title.size() > 0 && data.title.size() <= 150
        && data.amount is number && data.amount > 0
        && data.category is string && data.category.size() <= 50
        && data.date is string && data.date.size() <= 30
        && data.paidBy is map
        && data.splitType is string && data.splitType.size() <= 30
        && data.splits is list && data.splits.size() > 0 && data.splits.size() <= 50
        && data.createdAt is number;
    }

    function isValidKitty(data, tripId) {
      return data.id is string && data.id.size() <= 128
        && data.tripId == tripId
        && data.memberId is string && data.memberId.size() <= 128
        && data.amount is number && data.amount > 0
        && data.date is string && data.date.size() <= 30
        && data.createdAt is number;
    }

    function isValidSettlement(data, tripId) {
      return data.id is string && data.id.size() <= 128
        && data.tripId == tripId
        && data.fromMemberId is string && data.fromMemberId.size() <= 128
        && data.toMemberId is string && data.toMemberId.size() <= 128
        && data.amount is number && data.amount > 0
        && data.date is string && data.date.size() <= 30
        && data.createdAt is number;
    }

    // Private trips. Queries must be scoped to the signed-in user's membership.
    match /trips/{tripId} {
      allow get: if isValidId(tripId) && isTripMember(resource.data);
      allow list: if request.auth != null && resource.data.memberUids is list
        && request.auth.uid in resource.data.memberUids;
      allow create: if request.auth != null && isValidId(tripId)
        && isValidTrip(incoming()) && incoming().id == tripId
        && incoming().ownerUid == request.auth.uid
        && request.auth.uid in incoming().memberUids;
      allow update: if request.auth != null && isValidId(tripId)
        && isValidTrip(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().ownerUid == existing().ownerUid
        && incoming().inviteCode == existing().inviteCode
        && (
          existing().ownerUid == request.auth.uid
          || (
            isTripMember(existing())
            && incoming().memberUids == existing().memberUids
          )
          || (
            incoming().name == existing().name
            && incoming().destination == existing().destination
            && incoming().startDate == existing().startDate
            && incoming().endDate == existing().endDate
            && incoming().currency == existing().currency
            && incoming().memberUids is list
            && incoming().memberUids.hasAll(existing().memberUids)
            && incoming().memberUids.size() == existing().memberUids.size() + 1
            && request.auth.uid in incoming().memberUids
            && incoming().members is list
            && incoming().members.hasAll(existing().members)
            && incoming().members.size() == existing().members.size() + 1
            && incoming().members[incoming().members.size() - 1].id == request.auth.uid
            && incoming().joinCodeAttempt == existing().inviteCode
          )
        );
      allow delete: if request.auth != null && existing().ownerUid == request.auth.uid;

      match /expenses/{expenseId} {
        allow read: if isValidId(tripId) && canAccessTrip(tripId);
        allow create: if isValidId(tripId) && isValidId(expenseId) && canAccessTrip(tripId)
          && isValidExpense(incoming(), tripId);
        allow update: if isValidId(tripId) && isValidId(expenseId) && canAccessTrip(tripId)
          && isValidExpense(incoming(), tripId) && incoming().id == existing().id
          && incoming().tripId == existing().tripId && incoming().createdAt == existing().createdAt;
        allow delete: if isValidId(tripId) && isValidId(expenseId) && canAccessTrip(tripId);
      }

      match /kitty/{kittyId} {
        allow read: if isValidId(tripId) && canAccessTrip(tripId);
        allow create: if isValidId(tripId) && isValidId(kittyId) && canAccessTrip(tripId)
          && isValidKitty(incoming(), tripId);
        allow update: if isValidId(tripId) && isValidId(kittyId) && canAccessTrip(tripId)
          && isValidKitty(incoming(), tripId);
        allow delete: if isValidId(tripId) && isValidId(kittyId) && canAccessTrip(tripId);
      }

      match /settlements/{settlementId} {
        allow read: if isValidId(tripId) && canAccessTrip(tripId);
        allow create: if isValidId(tripId) && isValidId(settlementId) && canAccessTrip(tripId)
          && isValidSettlement(incoming(), tripId);
        allow update: if isValidId(tripId) && isValidId(settlementId) && canAccessTrip(tripId)
          && isValidSettlement(incoming(), tripId);
        allow delete: if isValidId(tripId) && isValidId(settlementId) && canAccessTrip(tripId);
      }

      match /itinerary/{stopId} {
        allow read: if isValidId(tripId) && isValidId(stopId) && canAccessTrip(tripId);
        allow create, update: if isValidId(tripId) && isValidId(stopId) && canAccessTrip(tripId)
          && incoming().id == stopId
          && incoming().date is string && incoming().date.size() <= 10
          && incoming().time is string && incoming().time.size() <= 10
          && incoming().title is string && incoming().title.size() > 0 && incoming().title.size() <= 150
          && incoming().location is string && incoming().location.size() <= 200
          && incoming().category is string && incoming().category.size() <= 50
          && incoming().budget is string && incoming().budget.size() <= 30
          && incoming().notes is string && incoming().notes.size() <= 2000;
        allow delete: if isValidId(tripId) && isValidId(stopId) && canAccessTrip(tripId);
      }
    }

    // Opt-in reusable itinerary templates. Everyone may search/read; only signed-in
    // authors may create, and only the author may later edit/delete their own template.
    match /itineraryTemplates/{templateId} {
      allow get, list: if true;
      allow create: if request.auth != null
        && isValidId(templateId)
        && incoming().id == templateId
        && incoming().authorUid == request.auth.uid
        && incoming().title is string && incoming().title.size() > 0 && incoming().title.size() <= 120
        && incoming().destination is string && incoming().destination.size() > 0 && incoming().destination.size() <= 120
        && incoming().destinationKey is string && incoming().destinationKey.size() > 0 && incoming().destinationKey.size() <= 120
        && incoming().currency is string && incoming().currency.size() >= 3 && incoming().currency.size() <= 10
        && incoming().stops is list && incoming().stops.size() > 0 && incoming().stops.size() <= 100
        && incoming().createdAt is number;
      allow update, delete: if request.auth != null
        && existing().authorUid == request.auth.uid;
    }
  }
}
